<Page
    x:Class="ChampionsCompanion.App.Pages.CardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cards"
    Loaded="OnLoaded"
>
    <Page.Resources>
        <Style x:Key="cbFiltres" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,5,0"></Setter>
        </Style>

        <Style x:Key="btCards" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,5,0"></Setter>
        </Style>

    </Page.Resources>

    <StackPanel Margin="32,16">
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="{StaticResource SubtleTextBrush}"  />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Cards" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
            <Button Grid.Column="1" Style="{StaticResource btCards}" HorizontalAlignment="Right" x:Name="btDtg" Click="btDtg_Click">Grid</Button>
            <Button Grid.Column="2" Style="{StaticResource btCards}" HorizontalAlignment="Right" x:Name="btLsv" Click="btLsv_Click">Cards</Button>
            <Button Grid.Column="3" Style="{StaticResource btCards}" HorizontalAlignment="Right" Padding="10,10,20,10" Background="{StaticResource AccentBrush}" Foreground="Black">+ New Card</Button>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0">Name or subtitle</Label>
            <Label Grid.Column="1" Grid.Row="0">Aspect</Label>
            <Label Grid.Column="2" Grid.Row="0">Type</Label>
            <Label Grid.Column="3" Grid.Row="0">Cost</Label>
            <Label Grid.Column="4" Grid.Row="0">Pack</Label>
            <Label Grid.Column="5" Grid.Row="0">Hero</Label>

            <TextBox x:Name="txtName" Grid.Column="0" Grid.Row="1" Margin="0,0,5,0"></TextBox>
            <ComboBox x:Name="cbAspect" Grid.Column="1" Grid.Row="1" Style="{StaticResource cbFiltres}"></ComboBox>
            <ComboBox x:Name="cbType" Grid.Column="2" Grid.Row="1" Style="{StaticResource cbFiltres}"></ComboBox>
            <ComboBox x:Name="cbCost" Grid.Column="3" Grid.Row="1" Style="{StaticResource cbFiltres}"></ComboBox>
            <ComboBox x:Name="cbPack" Grid.Column="4" Grid.Row="1" Style="{StaticResource cbFiltres}"></ComboBox>
            <ComboBox x:Name="cbHero" Grid.Column="5" Grid.Row="1" IsEnabled="False" Style="{StaticResource cbFiltres}"></ComboBox>
        </Grid>

        <DataGrid x:Name="dtgCards" AutoGenerateColumns="False" ScrollViewer.VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}"></DataGridTextColumn>
                <DataGridTemplateColumn Header="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="{Binding Title}" Margin="0,0,8,0">
                                
                                </TextBlock>
                                <TextBlock Text="{Binding Subtitle}" Foreground="Gray">

                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="Type" Binding="{Binding Type}"></DataGridTextColumn>
                <DataGridTemplateColumn Header="Unique">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="8,4"
                                    CornerRadius="15"
                                    HorizontalAlignment="Left">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Gray"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding AspectId}" Value="1">
                                                <Setter Property="Background" Value="{StaticResource Aspect.hero}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="4">
                                                <Setter Property="Background" Value="{StaticResource Aspect.aggression}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="3">
                                                <Setter Property="Background" Value="{StaticResource Aspect.justice}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="6">
                                                <Setter Property="Background" Value="{StaticResource Aspect.leadership}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="5">
                                                <Setter Property="Background" Value="{StaticResource Aspect.protection}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="2">
                                                <Setter Property="Background" Value="{StaticResource Aspect.basic}"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding Aspect}"
                                   Foreground="Black"
                                   FontWeight="Medium"/>
                            </Border>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                
                <DataGridTextColumn Header="Cost" Binding="{Binding Cost}"></DataGridTextColumn>
                <DataGridTextColumn Header="Aspect" Binding="{Binding Aspect}"></DataGridTextColumn>
                <DataGridTextColumn Header="Traits" Binding="{Binding Traits}"></DataGridTextColumn>
                <DataGridTextColumn Header="Hero" Binding="{Binding Hero}"></DataGridTextColumn>
                <DataGridTextColumn Header="Pack" Binding="{Binding Pack}"></DataGridTextColumn>
                
                
                <DataGridTemplateColumn Header="Unique">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="●" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnique}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    
                    
                </DataGridTemplateColumn>
                
                
            </DataGrid.Columns>
        </DataGrid>

        <ListView x:Name="lsvCards" ScrollViewer.VerticalScrollBarVisibility="Visible" Visibility="Hidden">
            <ListViewItem>
                <DataTemplate>
                    <Grid>
                        <Image Source="{Binding ImagePath}"></Image>
                    </Grid>
                </DataTemplate>
            </ListViewItem>
        </ListView>
        <!-- TODO C.1: filters, grid mode (DataGrid) and card mode (ListView + CardView custom control). -->
    </StackPanel>
</Page>
