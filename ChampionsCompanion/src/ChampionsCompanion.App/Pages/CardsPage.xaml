<Page
    x:Class="ChampionsCompanion.App.Pages.CardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cards"
    Loaded="OnLoaded"
   
    
>
    <Page.Resources>
        <Style x:Key="cbFiltres" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,5,0"></Setter>
        </Style>

        <Style x:Key="btCards" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,5,0"></Setter>
        </Style>

    </Page.Resources>

    <Page.Background>
        <VisualBrush Stretch="UniformToFill" >
            <VisualBrush.Visual>
                <Image Source="C:\Users\Aleix Masip\Documents\Repos\DI\Practica 1\ChampionsCompanion\src\ChampionsCompanion.App\Images\nebula_background.jpg">
                    <Image.Effect>
                        <BlurEffect></BlurEffect>
                    </Image.Effect>
                </Image>
            </VisualBrush.Visual>
        </VisualBrush>
    </Page.Background>
    
    <StackPanel Margin="32,16">
        
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="{StaticResource SubtleTextBrush}"  />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="5*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Cards" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
            <Button Grid.Column="1" Style="{StaticResource btCards}" HorizontalAlignment="Right" x:Name="btDtg" Click="btDtg_Click">Grid</Button>
            <Button Grid.Column="2" Style="{StaticResource btCards}" HorizontalAlignment="Right" x:Name="btLsv" Click="btLsv_Click">Cards</Button>
            <Button Grid.Column="3" Style="{StaticResource btCards}" HorizontalAlignment="Right" Padding="10,10,20,10" Background="{StaticResource AccentBrush}" Foreground="Black" x:Name="btNewCard" Click="btNewCard_Click">+ New Card</Button>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="10*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
                <ColumnDefinition Width="15*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Column="0" Grid.Row="0">Name or subtitle</Label>
            <Label Grid.Column="1" Grid.Row="0">Aspect</Label>
            <Label Grid.Column="2" Grid.Row="0">Type</Label>
            <Label Grid.Column="3" Grid.Row="0">Cost</Label>
            <Label Grid.Column="4" Grid.Row="0">Pack</Label>
            <Label Grid.Column="5" Grid.Row="0">Hero</Label>

            <TextBox x:Name="txtName" Grid.Column="0" Grid.Row="1" Margin="0,0,5,0" KeyDown="txtName_KeyDown"></TextBox>
            <ComboBox x:Name="cbAspect" Grid.Column="1" Grid.Row="1" Style="{StaticResource cbFiltres}" SelectionChanged="cbSelectionChanged"></ComboBox>
            <ComboBox x:Name="cbType" Grid.Column="2" Grid.Row="1" Style="{StaticResource cbFiltres}" SelectionChanged="cbSelectionChanged"></ComboBox>
            <ComboBox x:Name="cbCost" Grid.Column="3" Grid.Row="1" Style="{StaticResource cbFiltres}" SelectionChanged="cbSelectionChanged"></ComboBox>
            <ComboBox x:Name="cbPack" Grid.Column="4" Grid.Row="1" Style="{StaticResource cbFiltres}" SelectionChanged="cbSelectionChanged"></ComboBox>
            <ComboBox x:Name="cbHero" Grid.Column="5" Grid.Row="1" IsEnabled="False" Style="{StaticResource cbFiltres}" SelectionChanged="cbSelectionChanged"></ComboBox>
        </Grid>
        <Label x:Name="lbCardCount"></Label>
        <DataGrid x:Name="dtgCards" AutoGenerateColumns="False" ScrollViewer.VerticalScrollBarVisibility="Visible">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}"></DataGridTextColumn>
                <DataGridTemplateColumn Header="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Text="{Binding Title}" Margin="0,0,8,0">
                                
                                </TextBlock>
                                <TextBlock Text="{Binding Subtitle}" Foreground="Gray">

                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="Type" Binding="{Binding Type}"></DataGridTextColumn>
                <DataGridTemplateColumn Header="Unique">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="8,4"
                                    CornerRadius="15"
                                    HorizontalAlignment="Left">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Gray"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding AspectId}" Value="1">
                                                <Setter Property="Background" Value="{StaticResource Aspect.hero}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="4">
                                                <Setter Property="Background" Value="{StaticResource Aspect.aggression}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="3">
                                                <Setter Property="Background" Value="{StaticResource Aspect.justice}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="6">
                                                <Setter Property="Background" Value="{StaticResource Aspect.leadership}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="5">
                                                <Setter Property="Background" Value="{StaticResource Aspect.protection}"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding AspectId}" Value="2">
                                                <Setter Property="Background" Value="{StaticResource Aspect.basic}"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding Aspect}"
                                   Foreground="Black"
                                   FontWeight="Medium"/>
                            </Border>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                
                <DataGridTemplateColumn Header="Cost">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Cost, TargetNullValue='---'}"></TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Traits" Binding="{Binding Traits}"></DataGridTextColumn>
                
                <DataGridTextColumn Header="Hero" Binding="{Binding Hero}"></DataGridTextColumn>
                <DataGridTextColumn Header="Pack" Binding="{Binding Pack}"></DataGridTextColumn>
                
                
                <DataGridTemplateColumn Header="Unique">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="●" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnique}" Value="False">
                                                <Setter Property="Visibility" Value="Hidden"></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    
                    
                </DataGridTemplateColumn>
                
                
            </DataGrid.Columns>
        </DataGrid>




        <ListView x:Name="lsvCards" ScrollViewer.VerticalScrollBarVisibility="Visible" Visibility="Collapsed" Background="Transparent" BorderBrush="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
                    <Setter Property="Padding" Value="0"></Setter>
                    <Setter Property="Margin" Value="0,0,0,12"></Setter>
                    <Setter Property="Background" Value="Transparent"></Setter>
                    <Setter Property="BorderThickness" Value="0"></Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#111111" BorderBrush="#383838" BorderThickness="1" CornerRadius="9" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding ImagePath}" Width="150" Height="210" Stretch="UniformToFill" VerticalAlignment="Top"></Image>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Label Content="●" Foreground="White" Margin="0,0,8,0"></Label>
                                    <Label Content="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"></Label>
                                    <Label Content="{Binding Subtitle}" Foreground="LightGray" Margin="10,0,0,0"></Label>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                    

                                    <Label Content="{Binding Type}" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"></Label>

                                    <Border Padding="10,4" CornerRadius="15" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Gray"></Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AspectId}" Value="1">
                                                        <Setter Property="Background" Value="{StaticResource Aspect.hero}"></Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AspectId}" Value="4">
                                                        <Setter Property="Background" Value="{StaticResource Aspect.aggression}"></Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AspectId}" Value="3">
                                                        <Setter Property="Background" Value="{StaticResource Aspect.justice}"></Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AspectId}" Value="6">
                                                        <Setter Property="Background" Value="{StaticResource Aspect.leadership}"></Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AspectId}" Value="5">
                                                        <Setter Property="Background" Value="{StaticResource Aspect.protection}"></Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AspectId}" Value="2">
                                                        <Setter Property="Background" Value="{StaticResource Aspect.basic}"></Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Label Content="{Binding Aspect}" Foreground="Black" FontWeight="Medium" Padding="0"></Label>
                                    </Border>

                                    <Label Foreground="White" Margin="0,0,10,0">Cost </Label>
                                    <Label Content="{Binding Cost, TargetNullValue='---'}" Foreground="White" Margin="0,0,10,0"></Label>
                                    <Label Foreground="White" Margin="0,0,10,0"> Resource</Label>
                                    <Label Content="{Binding Pack}" Foreground="White" Margin="0,0,10,0"></Label>
                                    <Label Content="{Binding PackId}" Foreground="White" Margin="0,0,10,0"></Label>
                                    
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type.Name}" Value="Ally">
                                                    <Setter Property="Visibility" Value="Visible"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    
                                    <Border  Background="{StaticResource PanelBorderBrush}" CornerRadius="15" Padding="20,10,20,10" Margin="0,5,5,5">
                                        <StackPanel Orientation="Vertical">
                                            <Label Margin="0,0,0,5">ATK</Label>
                                            <Label x:Name="lbPrevAtk" Content="{Binding Attack}"></Label>
                                        </StackPanel>
                                    </Border>
                                    <Border  Background="{StaticResource PanelBorderBrush}" CornerRadius="15" Padding="20,10,20,10" Margin="0,5,5,5">
                                        <StackPanel Orientation="Vertical">
                                            <Label Margin="0,0,0,5">THW</Label>
                                            <Label x:Name="lbPrevTHW" Content="{Binding Thwart}"></Label>
                                        </StackPanel>
                                    </Border>
                                    <Border  Background="{StaticResource PanelBorderBrush}" CornerRadius="15" Padding="20,10,20,10" Margin="0,5,5,5">
                                        <StackPanel Orientation="Vertical">
                                            <Label Margin="0,0,0,5">HP</Label>
                                            <Label x:Name="lbPrevHP" Content="{Binding Health}"></Label>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                
                                <Label Content="{Binding Traits}" Foreground="White" Padding="0" ></Label>
                                <Label Content="{Binding Text}" Foreground="White" Padding="0" ></Label>
                                <Label Content="{Binding Flavor}" Foreground="{StaticResource DimTextBrush}" Padding="0" ></Label>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- TODO C.1: filters, grid mode (DataGrid) and card mode (ListView + CardView custom control). -->
    </StackPanel>
</Page>
